    {
      "name": "Add a Favourite",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 or 201\", function () {\r",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);\r",
              "});\r",
              "\r",
              "pm.test(\"Response contains favourite id\", function () {\r",
              "    const json = pm.response.json();\r",
              "    pm.expect(json).to.have.property(\"id\");\r",
              "});\r",
              "\r",
              "pm.test(\"Save favourite id to environment\", function () {\r",
              "    const json = pm.response.json();\r",
              "    pm.environment.set(\"favourite_id\", json.id);\r",
              "    pm.globals.set(\"favourite_id\", json.id);\r",
              "    console.log(\"Saved favourite_id:\", json.id);\r",
              "    pm.expect(json.id).to.be.a(\"number\");\r",
              "});\r",
              "\r",
              "pm.test(\"Response contains success message or id\", function () {\r",
              "    const json = pm.response.json();\r",
              "    const isSuccess = json.message === \"SUCCESS\" || json.id;\r",
              "    pm.expect(isSuccess).to.be.ok;\r",
              "});\r",
              "\r",
              "pm.test(\"Response time is under 3000ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(3000);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const baseUrl = \"https://api.thedogapi.com/v1\";\r",
              "const apiKey = pm.environment.get(\"dog_api_key\");\r",
              "const favId = pm.environment.get(\"favourite_id\");\r",
              "\r",
              "// Clean up existing favourite first\r",
              "if (favId) {\r",
              "    pm.sendRequest({\r",
              "        url: `${baseUrl}/favourites/${favId}`,\r",
              "        method: \"DELETE\",\r",
              "        header: { \"x-api-key\": apiKey }\r",
              "    }, function (err, res) {\r",
              "        console.log(\"Cleaned up favourite:\", favId);\r",
              "    });\r",
              "}\r",
              "\r",
              "// Fetch a valid image ID from breeds endpoint\r",
              "pm.sendRequest({\r",
              "    url: `${baseUrl}/images/search?limit=1&breed_ids=1`,\r",
              "    method: \"GET\",\r",
              "    header: { \"x-api-key\": apiKey }\r",
              "}, function (err, res) {\r",
              "    const image = res.json()[0];\r",
              "    pm.environment.set(\"random_image_id\", image.id);\r",
              "    console.log(\"Got valid image ID:\", image.id);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
